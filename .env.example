# Kopiér til .env (indlæses automatisk af `npm start`) eller sæt som miljøvariabler – alle er valgfrie.

# Port og adresse serveren lytter på (standard 3000 og 0.0.0.0 = alle netkort)
PORT=3000
HOST=0.0.0.0

# Mappe hvor beholdninger, adgangskode-hash og session-nøgle gemmes (standard ./data)
DATA_DIR=./data

# Sæt en adgangskode her for at springe "opret adgangskode"-siden over ved første start.
# Hvis den er tom, oprettes adgangskoden i browseren første gang du åbner siden.
DASHBOARD_PASSWORD=

# Hvor længe kurser caches i sekunder (standard 60, mindst 10). Yahoo blokerer ved for mange kald.
QUOTE_CACHE_SECONDS=60

# Fast nøgle til login-sessioner. Genereres og gemmes automatisk hvis tom.
SESSION_SECRET=

# Opsætningsnøgle der kræves for at oprette den første adgangskode fra en ANDEN maskine end
# serveren selv (localhost behøver ingen). Genereres og skrives i loggen hvis tom.
SETUP_TOKEN=

# Genhent kurser i baggrunden mens en børs er åben (standard 1)
WARM_CACHE=1

# 1 = brug indbyggede testkurser i stedet for Yahoo Finance (til udvikling)
YAHOO_MOCK=0

# Sæt til 1 når appen kører bag en reverse proxy (Caddy/Nginx), så X-Forwarded-For/-Proto bruges
# til login-bremsen og Secure-cookies. Lad være tom hvis Node lytter direkte på nettet.
TRUST_PROXY=

# Tving Secure-flag på cookies (sættes automatisk bag en proxy med TRUST_PROXY=1 og HTTPS)
SECURE_COOKIES=

# Basisvaluta som porteføljen summeres i (standard DKK). Kan også ændres i dashboardet.
BASE_CURRENCY=DKK

# Database, så porteføljen følger med til alle enheder. Uden dem gemmes data i DATA_DIR
# (lokalt/Docker) eller i brugerens egen browser (på Vercel).
# Supabase – se docs/database.md for SQL'en der skal køres først:
SUPABASE_URL=
SUPABASE_KEY=
# Upstash Redis – sættes automatisk af Vercels Storage-fane:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 1 = ingen login: alle med adressen ser og redigerer den samme portefølje. Kræver en database.
# På Vercel slås den automatisk til, når der er en database og ingen DASHBOARD_PASSWORD;
# sæt 0 for at kræve login alligevel.
PUBLIC_ACCESS=
